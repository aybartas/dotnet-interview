{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build debugging-exercises",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/debugging-exercises/DebuggingExercises.csproj"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build analyzers-nullable",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/analyzers-nullable/AnalyzersNullable.csproj"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch (hot reload)",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "--project", "${workspaceFolder}/watch-demo/WatchDemo.csproj"],
      "isBackground": true,
      "problemMatcher": "$msCompile"
    }
  ]
}
