# J1.5 — Örnek .editorconfig
#
# .editorconfig; IDE'nin, `dotnet format`'ın ve DERLEYİCİNİN okuduğu, repoyla birlikte giden biçim + analyzer kuralları dosyasıdır.
# "Bende güzel görünüyordu" tartışmasını bitirir: kural dosyada, herkes aynı kurala tabi. Dosya, bulunduğu klasör ve altı için geçerlidir;
# `root = true` yukarıdaki .editorconfig dosyalarına bakmayı durdurur.
root = true

# ─────────────────────────────── Tüm dosyalar ───────────────────────────────
[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,json,yml,yaml,slnx}]
indent_size = 2

# ─────────────────────────────── C# biçim ve stil ───────────────────────────────
[*.cs]
# --- using / namespace ---
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:suggestion

# --- Süslü parantez ve girinti (Allman stili) ---
csharp_new_line_before_open_brace = all
csharp_indent_case_contents = true

# --- var kullanımı ---
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# --- Ifade gövdeli üyeler, desen eşleme ---
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_prefer_collection_expression = when_types_loosely_match:suggestion

# --- Adlandırma kuralları (IDE1006) ---
# Kural 1: interface'ler 'I' ile başlar
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = begins_with_i
dotnet_naming_rule.interfaces_start_with_i.severity = suggestion
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case

# Kural 2: private alanlar '_camelCase'
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# ─────────────────────────────── Analyzer önem dereceleri ───────────────────────────────
# Önem derecesi: none | silent | suggestion | warning | error
# Format:  dotnet_diagnostic.<KURAL-ID>.severity = <derece>

# Nullable: null referans uyarıları (CS86xx). Varsayılan 'warning'. Ciddiye alıyorsanız 'error' yapın.
dotnet_diagnostic.CS8600.severity = warning   # null'ı non-nullable'a çevirme
dotnet_diagnostic.CS8602.severity = warning   # null olabilecek referansı dereference etme
dotnet_diagnostic.CS8603.severity = warning   # null döndürme olasılığı
dotnet_diagnostic.CS8604.severity = warning   # null olabilecek argüman
dotnet_diagnostic.CS8618.severity = warning   # non-nullable alan constructor'da başlatılmadı

# Unutulan await (egzersiz 7'nin derleyici uyarısı)
dotnet_diagnostic.CS4014.severity = warning

# ─────────────────────────────── Sadece analyzers-nullable projesi ───────────────────────────────
# Bu proje bilerek uyarı üretsin diye bazı stil kurallarını 'warning' yapıyoruz. Gerçek projede
# sıkılaştırmayı TÜM repo için ve kademeli yapın.
[analyzers-nullable/**.cs]
dotnet_diagnostic.IDE0005.severity = warning   # Kullanılmayan using
dotnet_diagnostic.IDE0051.severity = warning   # Kullanılmayan private üye
dotnet_diagnostic.IDE0044.severity = warning   # Alan 'readonly' olabilir
dotnet_diagnostic.IDE1006.severity = warning   # Adlandırma kuralı ihlali
dotnet_diagnostic.CA1822.severity = warning    # Üye 'static' olabilir (instance durumu kullanmıyor)
dotnet_diagnostic.CA1861.severity = warning    # Sabit dizi argümanı: her çağrıda yeniden allocate edilir
