<Project Sdk="Microsoft.NET.Sdk">

  <!-- J5: Build & Run Temelleri — üç konu tek console projesinde (klasör = konu). Çalıştırma: dotnet run, ardından konu ve bölüm numarası (bkz. Program.cs) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Junior.BuildRunBasics</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- J5.2: CopyToOutputDirectory — bu dosya bin/<config>/<tfm>/ klasörüne appsettings.json adıyla kopyalanır (Link: konu klasörü yolu çıktıya taşınmaz) -->
    <None Include="02-bin-obj/appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
