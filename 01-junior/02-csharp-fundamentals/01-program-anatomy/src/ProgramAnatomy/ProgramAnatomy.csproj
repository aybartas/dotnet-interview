<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Junior.CSharpFundamentals.ProgramAnatomy</RootNamespace>
    <!-- /// yorumlarından XML dokümantasyon dosyası üret (bkz. Section12). Normalde IntelliSense ve OpenAPI bunu okur. -->
    <!-- Kök Directory.Build.props InvariantGlobalization=true yapar; kültür deneylerinin (tr-TR) çalışması için burada kapatıyoruz (ICU gerekir). -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
