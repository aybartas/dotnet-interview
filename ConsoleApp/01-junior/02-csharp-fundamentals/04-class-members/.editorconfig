# Analyzer setting for this folder: CA2214 ("do not call overridable methods in constructors") is OFF by default.
# We set it to 'warning' so that the demo code in Section03 INTENTIONALLY produces this warning. In the build output you should see:
#   warning CA2214: 'BaseWithVirtualCall..ctor()' contains a call chain that results in a call to a virtual method defined by the class
root = false

[*.cs]
dotnet_diagnostic.CA2214.severity = warning
