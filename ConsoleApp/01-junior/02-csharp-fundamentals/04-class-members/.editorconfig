# Bu klasör için analyzer ayarı: CA2214 ("constructor içinde overridable metot çağırma") varsayılan olarak KAPALIDIR.
# Section03'teki demo kodun BİLEREK bu uyarıyı üretmesi için 'warning' yapıyoruz. Derleme çıktısında şunu görmelisiniz:
#   warning CA2214: 'BaseWithVirtualCall..ctor()' contains a call chain that results in a call to a virtual method defined by the class
root = false

[*.cs]
dotnet_diagnostic.CA2214.severity = warning
