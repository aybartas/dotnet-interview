<Project>

  <!-- Tüm projeler için ortak ayarlar. Her konu kendi içinde bağımsızdır; burada sadece derleyici/analyzer tabanı var. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Eğitim reposu: uyarılar görünür kalsın ama build'i kırmasın. J1.5'te TreatWarningsAsErrors tartışılır. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
