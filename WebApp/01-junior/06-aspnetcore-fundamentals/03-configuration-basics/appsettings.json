{
  // Loaded explicitly by ConfigurationBasicsTopic (the lowest-priority source of this demo).
  // JSON comments are allowed in configuration files.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // The same key "Demo:Message" is also provided by the other sources (see /priority).
  "Demo": {
    "Message": "from appsettings.json"
  },

  // NOTE: there is deliberately NO "Password" here. Secrets never go into appsettings.json or git:
  // dev -> user-secrets, prod -> environment variable (Smtp__Password) / Key Vault. See README.
  "Smtp": {
    "Host": "smtp.example.com",
    "Port": 587,
    "UseSsl": true,
    "From": "noreply@example.com"
  },

  // Arrays are keyed by index: Endpoints:0:Name, Endpoints:1:Name ...
  "Endpoints": [
    { "Name": "primary", "Url": "https://primary.example.com" },
    { "Name": "backup", "Url": "https://backup.example.com" }
  ]
}
