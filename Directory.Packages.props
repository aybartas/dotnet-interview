<Project>

  <!-- Central Package Management: tüm projelerde paket sürümü TEK yerde tutulur.
       csproj içinde yalnızca <PackageReference Include="..." /> yazılır (Version yazılmaz). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test (xUnit v3 → Microsoft.Testing.Platform; VSTest paketleri artık gerekmez) -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
