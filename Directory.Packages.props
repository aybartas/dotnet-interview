<Project>

  <!-- Central Package Management: tüm projelerde paket sürümü TEK yerde tutulur.
       csproj içinde yalnızca <PackageReference Include="..." /> yazılır (Version yazılmaz). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Yalnızca KONUSU test olan modüller (J10, M10…) kullanır; diğer modüllerde test projesi yoktur.
         xUnit v3 → Microsoft.Testing.Platform (global.json'daki test runner ayarıyla); VSTest paketleri artık gerekmez. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- C1 (AZ-900) C1.8: Blob Storage demosu, yerelde Azurite emülatörüyle -->
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
  </ItemGroup>

</Project>
